{
    "$schema":  "https://schema.tauri.app/config/2.0",
    "productName":  "BallCam Agent",
    "version":  "2.1.0",
    "identifier":  "tv.ballcam.agent",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "BallCam Agent",
                                    "width":  900,
                                    "height":  700,
                                    "resizable":  true,
                                    "center":  true,
                                    "decorations":  true,
                                    "visible":  false,
                                    "minWidth":  600,
                                    "minHeight":  500
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "createUpdaterArtifacts":  true,
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "windows":  {
                                   "certificateThumbprint":  null,
                                   "digestAlgorithm":  "sha256",
                                   "timestampUrl":  ""
                               }
               },
    "plugins":  {
                    "updater":  {
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBMkRCNDZGMzQzMTk0QzkKUldUSmxERTBiN1F0R3MvTG5KbjhTVEZmWnhOUFBBTVpBTjhuWStLMjcvMkpmS0Y3ZFFhblVJN0MK",
                                    "endpoints":  [
                                                      "https://github.com/MarlBurroW/ballcam-agent/releases/latest/download/latest.json"
                                                  ],
                                    "windows":  {
                                                    "installMode":  "passive"
                                                }
                                }
                }
}